{
  "version": "0.11.0",
  "name": "modality-cli-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-atomic/modality"
  },
  "homepage": "https://github.com/react-atomic/modality",
  "description": "Composable CLI utilities for building Bun/TypeScript command-line tools",
  "keywords": ["modality-cli-kit"],
  "author": "Hill <hill@kimo.com>",
  "license": "ISC",
  "git.addAICoAuthor": "off",
  "dependencies": {
    "modality-mcp-kit": "^2.1.0",
    "zod": "^4.6.4"
  },
  "optionalDependencies": {
    "@modality-counter/core": "^2.1.3"
  },
  "devDependencies": {
    "modality-bun-kit": "^1.4.2"
  },
  "exports": {
    "types": "./dist/types/index.d.ts",
    "require": "./dist/index.js",
    "import": "./dist/index.js"
  },
  "types": "./dist/types/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "modality-cli": "./dist/cli.js"
  },
  "scripts": {
    "build:clean": "find ./dist -name '*.*' | xargs rm -rf",
    "build:types": "bun tsc -p ./",
    "build:src": "bun build src/index.ts --outdir dist --target=node --external @modality-counter/core",
    "build:cli": "bun build src/cli.ts --outdir dist --target=bun --external @modality-counter/core",
    "build": "bun run build:clean && bun run build:types && bun run build:src && bun run build:cli",
    "test": "npm run build && bun test",
    "prepublishOnly": "npm t"
  },
  "files": ["dist", "package.json", "README.md"]
}
